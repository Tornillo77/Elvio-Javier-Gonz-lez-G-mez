rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // System users directory & global settings accessible by all workshop computers
    match /system_users/{userId} {
      allow read, write: if true;
    }

    match /system_config/{configId} {
      allow read, write: if true;
    }

    // User profile documents and calculations
    match /users/{userId} {
      allow get, list, create, update: if true;

      // User saved quotes and calculations
      match /quotes/{quoteId} {
        allow get, list, create, update, delete: if true;
      }

      // User saved work orders (OTs)
      match /work_orders/{orderId} {
        allow get, list, create, update, delete: if true;
      }
    }

    // System-wide work orders shared across all plant stations
    match /system_work_orders/{orderId} {
      allow read, write: if true;
    }
  }
}
